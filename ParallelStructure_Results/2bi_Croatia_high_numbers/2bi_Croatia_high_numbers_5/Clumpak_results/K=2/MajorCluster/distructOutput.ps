% PARAMETERS
72 500 translate 
1 1 scale
0 rotate
/setrim {3 setlinewidth} def 
/setsep {0.3 setlinewidth} def 
/setind {0.3 setlinewidth} def 
/fh {6} def    	% Font height 
/da {5} def    	% Distance above box at which to print names 
/db {-7} def    	% Distance below box at which to print names 
/bh {50} def    	% Height of the box 
/wi {0.301935} def    	% Width of an individual 
/aato {60} def  	% Angle at which to print text atop box 
/abel {60} def  	% Angle at which to print text below box 
/tot {1550} def   	% Total number of individuals 
/Helvetica-Bold findfont fh scalefont setfont 

% ABBREVIATED COMMANDS
/M {moveto} def
/R {rmoveto} def
/L {lineto} def
/V {rlineto} def
/Cfs {closepath fill stroke} def
/rotshow {
  dup dup stringwidth pop abel cos mul neg exch 
  stringwidth pop abel sin mul neg R
  gsave abel rotate show grestore
} def
/bhm {bh mul} def 	% Multiply by height of the box 
/nwi {wi neg} def   	% Negative width of an individual 
/wm {wi mul} def 	% Multiply by width of an individual 
/ru {bhm M wi 0 V 0} def   	% Right-upwards box motion 
/ld {bhm V nwi 0 V Cfs} def	% Left-downwards box closure motion
/bbm {-.3 add 2 div add wm fh 2 div add db M} def       	% Below-box motion
/abm {-.3 add 2 div add wm fh 2 div add bh da add M} def	% Above-box motion
/sc {setrgbcolor} def

